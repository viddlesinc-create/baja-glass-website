# Copy to .env.local for local dev. Production values live in Netlify → Site configuration → Environment variables.

# Meta Pixel / Dataset ID (public — bundled into client JS by Vite)
VITE_META_PIXEL_ID=

# Server-only (read by netlify/functions/meta-capi.mts). NEVER add a VITE_ prefix to these —
# Vite inlines every VITE_* var into the public bundle.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_VERSION=
# Set only while verifying in Events Manager → Test Events, then remove and redeploy.
META_TEST_EVENT_CODE=
